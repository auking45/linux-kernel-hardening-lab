# Hardening Feature: ARM64 BTI & PAC (Branch Target Identification & Pointer Authentication)
# Enable ARM64 userspace and kernel Pointer Authentication (backward-edge CFI / ROP defense)
CONFIG_ARM64_PTR_AUTH=y
CONFIG_ARM64_PTR_AUTH_KERNEL=y
# Enable ARM64 userspace and kernel Branch Target Identification (forward-edge CFI / JOP defense)
CONFIG_ARM64_BTI=y
CONFIG_ARM64_BTI_KERNEL=y
# Enable LKDTM test framework for CFI and PAC verification
CONFIG_LKDTM=y

