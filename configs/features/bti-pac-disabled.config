# Baseline Feature: ARM64 BTI & PAC Disabled
# Explicitly disable Pointer Authentication and Branch Target Identification
# CONFIG_ARM64_PTR_AUTH is not set
# CONFIG_ARM64_PTR_AUTH_KERNEL is not set
# CONFIG_ARM64_BTI is not set
# CONFIG_ARM64_BTI_KERNEL is not set
# Enable LKDTM test framework for comparative baseline evaluation
CONFIG_LKDTM=y

