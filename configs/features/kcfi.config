# Hardening Feature: Clang kCFI (Forward-edge Control Flow Integrity)
# Enables compiler-injected type hash checking on indirect function calls
CONFIG_CFI_CLANG=y
# Enables permissive diagnostic mode for in-guest verification without immediate panic
CONFIG_CFI_PERMISSIVE=y
# Enable LKDTM test framework for CFI forward edge testing
CONFIG_LKDTM=y

