# Baseline Feature: SLAB Freelist Hardening & Randomization Disabled
# Explicitly disable freelist pointer obfuscation and freelist order randomization
# CONFIG_SLAB_FREELIST_HARDENED is not set
# CONFIG_SLAB_FREELIST_RANDOM is not set
CONFIG_SLUB=y
# Enable LKDTM test framework for comparative baseline evaluation
CONFIG_LKDTM=y

