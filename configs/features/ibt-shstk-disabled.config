# Baseline Feature: x86 IBT & Shadow Stack Disabled
# Explicitly disable Indirect Branch Tracking and Userspace Shadow Stack
# CONFIG_X86_KERNEL_IBT is not set
# CONFIG_X86_USER_SHADOW_STACK is not set
# CONFIG_X86_CET is not set
# Enable LKDTM test framework for comparative baseline evaluation
CONFIG_LKDTM=y

