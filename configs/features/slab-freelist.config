# Hardening Feature: SLAB Freelist Hardening & Randomization
# Obfuscate free pointer metadata in freed slab objects to prevent freelist hijacking
CONFIG_SLAB_FREELIST_HARDENED=y
# Randomize freelist order per slab page to mitigate predictable heap spraying/grooming
CONFIG_SLAB_FREELIST_RANDOM=y
# Ensure standard SLUB allocator is active with debugging support
CONFIG_SLUB=y
CONFIG_SLUB_DEBUG=y
# Enable LKDTM test framework for heap corruption and double-free validation
CONFIG_LKDTM=y

