# Hardening Feature: x86 IBT & Shadow Stack (Intel CET Control Flow Integrity)
# Enables compiler-instrumented Indirect Branch Tracking (forward-edge CFI)
CONFIG_X86_KERNEL_IBT=y
# Enables hardware-enforced userspace Shadow Stack (backward-edge CFI / ROP defense)
CONFIG_X86_USER_SHADOW_STACK=y
# Enables Intel CET common support
CONFIG_X86_CET=y
# Enable LKDTM test framework for CFI verification
CONFIG_LKDTM=y

