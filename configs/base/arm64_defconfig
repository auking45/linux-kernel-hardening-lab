# Minimal baseline defconfig for ARM64 (aarch64) QEMU virt fast boot
CONFIG_64BIT=y
CONFIG_ARM64=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4

# Core Kernel & Executables
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y

# Initramfs & Compression
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# Devtmpfs & Virtual Filesystems
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEBUG_FS=y

# Serial Console (PL011 UART for ARM virt machine)
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_TTY=y

# ARM Virt Platform Support
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y

# Testing & Verification Tools
CONFIG_LKDTM=y
CONFIG_PANIC_TIMEOUT=1

